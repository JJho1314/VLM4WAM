+def _normalize_positive_integral(value, *, name: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, Integral):
+        raise TypeError(f"{name} must be a non-bool integer, got {value!r}")
+    value = int(value)
+    if value <= 0:
