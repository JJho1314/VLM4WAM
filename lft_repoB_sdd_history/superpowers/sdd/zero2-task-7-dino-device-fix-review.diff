+def test_dino_normalization_uses_input_device_and_dtype():
+    module = load_module("k1_dino_target_device", DINO_TARGET)
+
+    class FakeTeacher:
+        def __init__(self):
+            self.video_metadata = None
+
+        def get_future_feature(self, video, **_kwargs):
+            self.video_metadata = (video.device, video.dtype, tuple(video.shape))
+            patches = torch.empty(
+                video.shape[0],
+                256,
+                1024,
+                device=video.device,
+                dtype=video.dtype,
+            )
+            return patches, patches
+
+    encoder = module.DinoVideoTargetEncoder.__new__(module.DinoVideoTargetEncoder)
+    nn.Module.__init__(encoder)
+    encoder.effective_fps = 1.0
+    encoder._prep = lambda tensor: tensor
+    encoder.teacher = FakeTeacher()
+    encoder.register_buffer("mean", torch.zeros(1, 3, 1, 1, 1))
+    encoder.register_buffer("std", torch.ones(1, 3, 1, 1, 1))
+    current = torch.empty(2, 3, 2, 2, device="meta", dtype=torch.bfloat16)
+    future = torch.empty(2, 3, 2, 2, device="meta", dtype=torch.bfloat16)
+
+    current_target, future_target = encoder.encode_current_and_future(current, future)
+
+    assert encoder.mean.device.type == "cpu"
+    assert encoder.std.device.type == "cpu"
+    assert encoder.teacher.video_metadata == (
+        current.device,
+        current.dtype,
+        (2, 3, 3, 2, 2),
+    )
+    assert current_target.shape == future_target.shape == (2, 256, 1024)
+    assert current_target.device == future_target.device == current.device
+    assert current_target.dtype == future_target.dtype == current.dtype
+
